# =====================================================================
# Contoh konfigurasi notifier Gmail (DEMO).
# File asli JANGAN masuk git: salin ke /etc/donchian/notifier-demo.env,
# isi di sana, lalu:  sudo chmod 600 /etc/donchian/notifier-demo.env
# =====================================================================

NOTIF_LABEL=DEMO
NOTIF_SYMBOL=BTC/USDT:USDT
# 1 = akun Demo (demo-fapi). Untuk akun asli nanti: 0, dan pakai BINANCEUSDM_LIVE_*.
NOTIF_TESTNET=1
NOTIF_POLL_SECONDS=10
# Opsional: ambang take profit bot, cuma untuk ditampilkan di email.
NOTIF_TP_PCT=0.004
NOTIF_STATE_PATH=/home/Trabarei/test/data/notifier_state_demo.json

# --- Gmail pengirim ---------------------------------------------------
# Sebaiknya akun Gmail KHUSUS untuk bot, bukan akun pribadi utama.
# Password di sini adalah App Password 16 karakter, BUKAN password akun.
NOTIF_SMTP_USER=akunbot@gmail.com
NOTIF_SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Penerima, pisahkan koma.
NOTIF_TO=anda@gmail.com

# --- Akun Binance yang dipantau (READ-ONLY dipakai notifier) -----------
# Isi dengan key akun yang SAMA dengan yang dipakai bot.
BINANCEUSDM_TESTNET_API_KEY=
BINANCEUSDM_TESTNET_API_SECRET=
